# ---- Secrets (server-side only; never put these in the frontend) ----
GROQ_API_KEY=
SERPAPI_KEY=
# Optional: Ticketmaster Discovery API key for live event listings where Ticketmaster has coverage
TICKETMASTER_API_KEY=
AUTH_SECRET=replace-with-a-long-random-secret

# ---- LLM (Groq, OpenAI-compatible) ----
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
LLM_QUERY_PARSING=true

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*

# ---- Database ----
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/geoguide.db
# PostgreSQL + PostGIS + pgvector (production target):
# DATABASE_URL=postgresql+psycopg://geoguide:password@localhost:5432/geoguide
AUTO_SEED_PACKS=true

# ---- Semantic retrieval ----
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Location freshness (seconds / metres) ----
LOCATION_SOFT_MAX_AGE_S=600
LOCATION_HARD_MAX_AGE_S=3600
LOCATION_LOW_ACCURACY_M=500
